# BACKEND ENVIRONMENT VARIABLES CONFIGURATION
PORT=5000
NODE_ENV=production

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/CampusCart-2

# Auth Secrets
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_EXPIRE=7d
ACCESS_TOKEN_EXPIRE=15M

# CORS Allowed Origins
CLIENT_URL=https://your-frontend-domain.vercel.app
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173

# Email Nodemailer Credentials (Gmail App Password)
USER=your_email@gmail.com
PASS=your_app_password

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
