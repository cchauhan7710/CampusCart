# ==========================================
# CAMPUSCART ENVIRONMENT CONFIGURATION SETUP
# ==========================================

# ----------------------------
# BACKEND ENVIRONMENT VARIABLES
# ----------------------------
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/CampusCart-2

# JWT Authentication Secrets & Expirations
JWT_SECRET=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRE=15M
REFRESH_TOKEN_EXPIRE=7d

# CORS Allowed Origins (Comma separated for multiple)
CLIENT_URL=https://your-campuscart-frontend.vercel.app
ALLOWED_ORIGINS=https://your-campuscart-frontend.vercel.app,http://localhost:5173

# Email Service SMTP Configuration (Gmail App Password)
USER=your_email@gmail.com
PASS=your_gmail_app_password

# Cloudinary Media Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# -----------------------------
# FRONTEND ENVIRONMENT VARIABLE
# -----------------------------
# Point this to your hosted Backend API URL (ending with /api or domain root)
VITE_API_URL=https://your-campuscart-backend.onrender.com/api
